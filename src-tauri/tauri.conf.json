{
  "$schema": "https://schema.tauri.app.config/2",
  "productName": "HexHawk",
  "version": "1.0.0",
  "identifier": "com.hexhawk.app",
  "build": {
    "beforeBuildCommand": "yarn workspace hexhawk-ui build",
    "beforeBundleCommand": "node scripts/release/stage-webview2-loader.mjs",
    "beforeDevCommand": "yarn workspace hexhawk-ui dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../HexHawk/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HexHawk",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Binary analysis and reverse engineering workbench",
    "longDescription": "HexHawk is a bounded Windows static-analysis workbench for authorized PE32/x86 and PE32+/x64 EXE/DLL inputs: file identity, readable text, machine instructions, code paths, a GYRE-owned assessment, NEST evidence lifecycle and report handoff. This unsigned engineering candidate is not release approved or a safety certificate; advanced execution, scripting, plugins, online AI and other formats/platforms are excluded.",
    "copyright": "Copyright © 2026 HexHawk Team",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": false,
    "resources": [
      "../README.md",
      "../docs/HEXHAWK_FOR_DUMMIES.md",
      "../docs/HIGH_ASSURANCE_GUIDE.md"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "installMode": "perMachine",
        "installerHooks": "nsis/hexhawk-runtime-payload.nsh"
      },
      "wix": {
        "language": "en-US",
        "template": null,
        "fragmentPaths": [
          "wix/hexhawk-registry.wxs"
        ],
        "componentGroupRefs": [
          "HexHawkEnterpriseRegistry"
        ],
        "componentRefs": [],
        "featureGroupRefs": [],
        "featureRefs": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "dialog": null
  }
}
